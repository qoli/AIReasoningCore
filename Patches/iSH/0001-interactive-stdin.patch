++ (BOOL)writeStandardInput:(NSData *)data forProcess:(int)pid {
+    ISHShellExecutionContext *ctx;
+    @synchronized(_activeExecutions) {
+        ctx = _activeExecutions[@(pid)];
+    }
+    if (!ctx || ctx.isCompleted) {
+        return NO;
+    }
+
+    @synchronized(ctx) {
+        if ([ctx stdinPipe][1] < 0) {
+            return NO;
+        }
+        const uint8_t *bytes = data.bytes;
+        size_t remaining = data.length;
+        while (remaining > 0) {
+            ssize_t written = write([ctx stdinPipe][1], bytes, remaining);
+            if (written < 0 && errno == EINTR) {
+                continue;
+            }
+            if (written <= 0) {
+                return NO;
+            }
+            bytes += written;
+            remaining -= (size_t)written;
+        }
+    }
+    return YES;
+}
+
++ (BOOL)closeStandardInputForProcess:(int)pid {
+    ISHShellExecutionContext *ctx;
+    @synchronized(_activeExecutions) {
+        ctx = _activeExecutions[@(pid)];
+    }
+    if (!ctx) {
+        return NO;
+    }
+    @synchronized(ctx) {
+        if ([ctx stdinPipe][1] < 0) {
+            return NO;
+        }
+        close([ctx stdinPipe][1]);
+        [ctx stdinPipe][1] = -1;
+        return YES;
+    }
+}
