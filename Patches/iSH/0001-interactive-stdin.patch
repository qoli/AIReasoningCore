++ (BOOL)killProcessGroup:(int)pid withSignal:(int)signal {
+    dword_t pgid = 0;
+    lock(&pids_lock);
+    struct task *task = pid_get_task((dword_t)pid);
+    if (task) {
+        pgid = task->group->pgid;
+    }
+    unlock(&pids_lock);
+    if (pgid == 0) {
+        return NO;
+    }
+    return send_group_signal(pgid, signal, SIGINFO_NIL) == 0;
+}
